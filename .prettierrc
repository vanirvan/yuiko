{
  "semi": true,
  "useTabs": false,
  "arrowParens": "always",
  "trailingComma": "all",
  "bracketSpacing": true,
  "printWidth": 80,
  "plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro"
      }
    }
  ]
}
