---
import ProjectLayout from "~/layouts/ProjectLayout.astro";

import CalculatorIcon from "/assets/fmc/mortgage-repayment-calculator/icon-calculator.svg?raw";
import EmptyIllustration from "/assets/fmc/mortgage-repayment-calculator/illustration-empty.svg?raw";
---

<ProjectLayout title="Mortgage repayment calculator">
  <div
    class="relative w-full min-h-svh bg-[#e3f4fc] flex flex-col items-center justify-center min-[376px]:p-3 sm:p-6 font-plus-jakarta"
  >
    <!-- Card -->
    <div
      class="relative flex flex-col md:flex-row bg-white w-full h-full min-[376px]:rounded-xl overflow-clip max-w-4xl"
    >
      <div class="py-6 px-3 md:px-6 flex flex-col gap-4 flex-1">
        <div
          class="flex flex-col md:flex-row gap-2 items-start md:justify-between md:items-center"
        >
          <h1 class="font-bold text-2xl text-slate-900">Mortgage Calculator</h1>
          <button id="clear-all-button" class="underline text-slate-500"
            >Clear All</button
          >
        </div>
        <form action="#" class="flex flex-col gap-4">
          <div class="space-y-2">
            <label for="mortgage-amount" class="text-slate-500"
              >Mortgage Amount</label
            >
            <div
              class="relative overflow-clip border border-slate-500 rounded-md flex items-center"
            >
              <div class="py-2 px-4 bg-[#e2f5fd]">
                <span class="font-semibold text-lg text-slate-700">€</span>
              </div>
              <input
                id="mortgage-amount"
                name="mortgage-amount"
                type="number"
                class="w-full focus:outline-none text-lg font-bold py-2 px-4"
              />
            </div>
          </div>
          <div class="flex flex-col md:flex-row gap-4">
            <div class="space-y-2">
              <label for="mortgage-term" class="text-slate-500"
                >Mortgage Term</label
              >
              <div
                class="relative overflow-clip border border-slate-500 rounded-md flex items-center"
              >
                <input
                  id="mortgage-term"
                  name="mortgage-term"
                  type="number"
                  class="w-full focus:outline-none text-lg font-bold py-2 px-4"
                />
                <div class="py-2 px-4 bg-[#e2f5fd]">
                  <span class="font-semibold text-lg text-slate-700">years</span
                  >
                </div>
              </div>
            </div>
            <div class="space-y-2">
              <label for="interest-rate" class="text-slate-500"
                >Interest Rate</label
              >
              <div
                class="relative overflow-clip border border-slate-500 rounded-md flex items-center"
              >
                <input
                  id="interest-rate"
                  name="interest-rate"
                  type="number"
                  class="w-full focus:outline-none text-lg font-bold py-2 px-4"
                />
                <div class="py-2 px-4 bg-[#e2f5fd]">
                  <span class="font-semibold text-lg text-slate-700">%</span>
                </div>
              </div>
            </div>
          </div>
          <div class="space-y-2">
            <label for="interest-rate" class="text-slate-500"
              >Mortgage Type</label
            >
            <div class="space-y-4">
              <label
                for="mortgage-type-repayment"
                class="flex items-center p-3 border rounded-md cursor-pointer bg-white hover:bg-slate-100 border-slate-700 has-[:checked]:bg-yellow-500/15 has-[:checked]:border-yellow-400"
              >
                <input
                  id="mortgage-type-repayment"
                  name="mortgage-type"
                  type="radio"
                  value="repayment"
                  class="hidden peer"
                />
                <span
                  class="w-4 h-4 mr-2 border-2 border-slate-700 rounded-full peer-checked:bg-yellow-400 peer-checked:border-yellow-400"
                ></span>
                <span
                  class="text-slate-700 font-semibold peer-checked:text-slate-700"
                  >Repayment</span
                >
              </label>
              <label
                for="mortgage-type-interest"
                class="flex items-center p-3 border rounded-md cursor-pointer bg-white hover:bg-slate-100 border-slate-700 has-[:checked]:bg-yellow-500/15 has-[:checked]:border-yellow-400"
              >
                <input
                  id="mortgage-type-interest"
                  name="mortgage-type"
                  type="radio"
                  value="interest"
                  class="hidden peer"
                />
                <span
                  class="w-4 h-4 mr-2 border-2 border-slate-700 rounded-full peer-checked:bg-yellow-400 peer-checked:border-yellow-400"
                ></span>
                <span
                  class="text-slate-700 font-semibold peer-checked:text-slate-700"
                  >Interest Only</span
                >
              </label>
            </div>
          </div>
          <button
            id="mortgage-submit"
            class="rounded-full bg-[#d9db30] font-semibold text-[#133041] flex items-center justify-center gap-4 px-12 py-4 w-full md:w-max"
          >
            <Fragment set:html={CalculatorIcon} />
            Calculate Repayment
          </button>
        </form>
      </div>
      <div
        id="mortgage-repayment-content"
        class="bg-[#133040] py-6 px-3 md:px-6 flex-1 md:rounded-bl-[4.5rem] flex flex-col gap-4"
      >
        <div
          class="flex flex-col items-center justify-center gap-4 w-full h-full"
        >
          <Fragment set:html={EmptyIllustration} />
          <h1 class="font-semibold text-white text-2xl text-center">
            Result shown here
          </h1>
          <h2 class="text-center text-slate-300">
            Complete the form and click "calculate repayments" to see what your
            monthly repayments would be.
          </h2>
        </div>
      </div>
    </div>
  </div>
</ProjectLayout>

<script>
  const inputMortgageAmount = document.getElementById(
    "mortgage-amount",
  ) as HTMLInputElement | null;
  const inputMortgageTerm = document.getElementById(
    "mortgage-term",
  ) as HTMLInputElement | null;
  const inputInterestRate = document.getElementById(
    "interest-rate",
  ) as HTMLInputElement | null;

  const mortgageContent = document.getElementById("mortgage-repayment-content");

  const clearAllButton = document.getElementById("clear-all-button");
  const submitButton = document.getElementById("mortgage-submit");

  clearAllButton?.addEventListener("click", function (e) {
    // radio button need to be initialized after click to prevent "null" value
    const radioMortgageType = document.querySelector(
      'input[name="mortgage-type"]:checked',
    ) as HTMLInputElement | null;

    if (inputMortgageAmount) {
      inputMortgageAmount.value = "";
    }
    if (inputMortgageTerm) {
      inputMortgageTerm.value = "";
    }
    if (inputInterestRate) {
      inputInterestRate.value = "";
    }
    if (radioMortgageType) {
      radioMortgageType.checked = false;
    }

    if (mortgageContent) {
      mortgageContent.innerHTML = `
      <div
          class="flex flex-col items-center justify-center gap-4 w-full h-full"
        >
          <Fragment set:html={EmptyIllustration} />
          <h1 class="font-semibold text-white text-2xl text-center">
            Result shown here
          </h1>
          <h2 class="text-center text-slate-300">
            Complete the form and click "calculate repayments" to see what your
            monthly repayments would be.
          </h2>
        </div>
      `;
    }
  });

  submitButton?.addEventListener("click", function (e) {
    e.preventDefault();

    if (mortgageContent) {
      mortgageContent.innerHTML = `
<h1 class="font-semibold text-white text-2xl">Your results</h1>
        <h2 class="text-slate-300">
          Your results are shown below based on the information you provided. To
          adjust the results, edit the form and click "calculate repayments"
          again.
        </h2>
        <div class="relative bg-[#d5dc47] rounded-md pt-1">
          <div class="relative bg-[#0e2431] rounded-md p-4 flex flex-col">
            <p class="text-slate-300">Your monthly repayments</p>
            <p class="text-[#d5dc47] font-bold text-[3.5rem]">€1,797.74</p>
            <div class="bg-[#324855] w-full rounded-full h-px"></div>
            <div class="flex flex-col gap-2 mt-4">
              <span class="text-slate-300"
                >Total you'll repay over the term</span
              >
              <span class="text-white font-bold text-2xl">€539,322.94</span>
            </div>
          </div>
        </div>
      `;
    }
  });
</script>
