---
import ProjectLayout from "~/layouts/ProjectLayout.astro";

import CalculatorIcon from "/assets/fmc/mortgage-repayment-calculator/icon-calculator.svg?raw";
import EmptyIllustration from "/assets/fmc/mortgage-repayment-calculator/illustration-empty.svg?raw";
---

<ProjectLayout title="Mortgage repayment calculator">
  <div
    class="relative flex min-h-svh w-full flex-col items-center justify-center bg-[#e3f4fc] font-plus-jakarta min-[376px]:p-3 sm:p-6"
  >
    <!-- Card -->
    <div
      class="relative flex h-full w-full max-w-4xl flex-col overflow-clip bg-white min-[376px]:rounded-xl md:flex-row"
    >
      <div class="flex flex-1 flex-col gap-4 px-3 py-6 md:px-6">
        <div
          class="flex flex-col items-start gap-2 md:flex-row md:items-center md:justify-between"
        >
          <h1 class="text-2xl font-bold text-slate-900">Mortgage Calculator</h1>
          <button id="clear-all-button" class="text-slate-500 underline"
            >Clear All</button
          >
        </div>
        <form action="#" class="flex flex-col gap-4">
          <div class="space-y-2">
            <label for="mortgage-amount" class="text-slate-500"
              >Mortgage Amount</label
            >
            <div
              class="relative flex items-center overflow-clip rounded-md border border-slate-500"
            >
              <div class="bg-[#e2f5fd] px-4 py-2">
                <span class="text-lg font-semibold text-slate-700">€</span>
              </div>
              <input
                id="mortgage-amount"
                name="mortgage-amount"
                type="number"
                class="w-full px-4 py-2 text-lg font-bold focus:outline-none"
              />
            </div>
          </div>
          <div class="flex flex-col gap-4 md:flex-row">
            <div class="space-y-2">
              <label for="mortgage-term" class="text-slate-500"
                >Mortgage Term</label
              >
              <div
                class="relative flex items-center overflow-clip rounded-md border border-slate-500"
              >
                <input
                  id="mortgage-term"
                  name="mortgage-term"
                  type="number"
                  class="w-full px-4 py-2 text-lg font-bold focus:outline-none"
                />
                <div class="bg-[#e2f5fd] px-4 py-2">
                  <span class="text-lg font-semibold text-slate-700">years</span
                  >
                </div>
              </div>
            </div>
            <div class="space-y-2">
              <label for="interest-rate" class="text-slate-500"
                >Interest Rate</label
              >
              <div
                class="relative flex items-center overflow-clip rounded-md border border-slate-500"
              >
                <input
                  id="interest-rate"
                  name="interest-rate"
                  type="number"
                  class="w-full px-4 py-2 text-lg font-bold focus:outline-none"
                />
                <div class="bg-[#e2f5fd] px-4 py-2">
                  <span class="text-lg font-semibold text-slate-700">%</span>
                </div>
              </div>
            </div>
          </div>
          <div class="space-y-2">
            <label for="interest-rate" class="text-slate-500"
              >Mortgage Type</label
            >
            <div class="space-y-4">
              <label
                for="mortgage-type-repayment"
                class="flex cursor-pointer items-center rounded-md border border-slate-700 bg-white p-3 hover:bg-slate-100 has-[:checked]:border-yellow-400 has-[:checked]:bg-yellow-500/15"
              >
                <input
                  id="mortgage-type-repayment"
                  name="mortgage-type"
                  type="radio"
                  value="repayment"
                  class="peer hidden"
                />
                <span
                  class="mr-2 h-4 w-4 rounded-full border-2 border-slate-700 peer-checked:border-yellow-400 peer-checked:bg-yellow-400"
                ></span>
                <span
                  class="font-semibold text-slate-700 peer-checked:text-slate-700"
                  >Repayment</span
                >
              </label>
              <label
                for="mortgage-type-interest"
                class="flex cursor-pointer items-center rounded-md border border-slate-700 bg-white p-3 hover:bg-slate-100 has-[:checked]:border-yellow-400 has-[:checked]:bg-yellow-500/15"
              >
                <input
                  id="mortgage-type-interest"
                  name="mortgage-type"
                  type="radio"
                  value="interest"
                  class="peer hidden"
                />
                <span
                  class="mr-2 h-4 w-4 rounded-full border-2 border-slate-700 peer-checked:border-yellow-400 peer-checked:bg-yellow-400"
                ></span>
                <span
                  class="font-semibold text-slate-700 peer-checked:text-slate-700"
                  >Interest Only</span
                >
              </label>
            </div>
          </div>
          <button
            id="mortgage-submit"
            class="flex w-full items-center justify-center gap-4 rounded-full bg-[#d9db30] px-12 py-4 font-semibold text-[#133041] md:w-max"
          >
            <Fragment set:html={CalculatorIcon} />
            Calculate Repayment
          </button>
        </form>
      </div>
      <div
        id="mortgage-repayment-content"
        class="flex flex-1 flex-col gap-4 bg-[#133040] px-3 py-6 md:rounded-bl-[4.5rem] md:px-6"
      >
        <div
          class="flex h-full w-full flex-col items-center justify-center gap-4"
        >
          <Fragment set:html={EmptyIllustration} />
          <h1 class="text-center text-2xl font-semibold text-white">
            Result shown here
          </h1>
          <h2 class="text-center text-slate-300">
            Complete the form and click "calculate repayments" to see what your
            monthly repayments would be.
          </h2>
        </div>
      </div>
    </div>
  </div>
</ProjectLayout>

<script>
  const inputMortgageAmount = document.getElementById(
    "mortgage-amount",
  ) as HTMLInputElement | null;
  const inputMortgageTerm = document.getElementById(
    "mortgage-term",
  ) as HTMLInputElement | null;
  const inputInterestRate = document.getElementById(
    "interest-rate",
  ) as HTMLInputElement | null;

  const mortgageContent = document.getElementById("mortgage-repayment-content");

  const clearAllButton = document.getElementById("clear-all-button");
  const submitButton = document.getElementById("mortgage-submit");

  function calculateRepayment(
    amount: number,
    years: number,
    interestRate: number,
    type: string,
  ) {
    const monthlyRate = interestRate / 100 / 12;
    const totalPayment = years * 12;

    const format = new Intl.NumberFormat("en-IE", {
      style: "currency",
      currency: "EUR",
      minimumFractionDigits: 2,
    });

    if (type == "repayment") {
      const monthlyRepayment =
        (amount * (monthlyRate * Math.pow(1 + monthlyRate, totalPayment))) /
        (Math.pow(1 + monthlyRate, totalPayment) - 1);
      const totalRepayment = monthlyRepayment * totalPayment;

      return {
        monthlyRepayment: format.format(monthlyRepayment),
        totalPayment: format.format(totalRepayment),
      };
    } else if (type === "interest") {
      const monthlyRepayment = amount * monthlyRate;
      const totalRepayment = monthlyRepayment * totalPayment + amount;

      return {
        monthlyRepayment: format.format(monthlyRepayment),
        totalPayment: format.format(totalRepayment),
      };
    } else {
      throw new Error("Invalid Mortgage Type: " + type);
    }
  }

  clearAllButton?.addEventListener("click", function () {
    // radio button need to be initialized after click to prevent "null" value
    const radioMortgageType = document.querySelector(
      'input[name="mortgage-type"]:checked',
    ) as HTMLInputElement | null;

    if (inputMortgageAmount) {
      inputMortgageAmount.value = "";
    }
    if (inputMortgageTerm) {
      inputMortgageTerm.value = "";
    }
    if (inputInterestRate) {
      inputInterestRate.value = "";
    }
    if (radioMortgageType) {
      radioMortgageType.checked = false;
    }
  });

  submitButton?.addEventListener("click", function (e) {
    e.preventDefault();

    // radio button need to be initialized after click to prevent "null" value
    const radioMortgageType = document.querySelector(
      'input[name="mortgage-type"]:checked',
    ) as HTMLInputElement | null;

    const { monthlyRepayment, totalPayment } = calculateRepayment(
      inputMortgageAmount ? +inputMortgageAmount.value : 0,
      inputMortgageTerm ? +inputMortgageTerm.value : 0,
      inputInterestRate ? +inputInterestRate.value : 0,
      radioMortgageType ? radioMortgageType.value : "",
    );

    if (mortgageContent) {
      mortgageContent.innerHTML = `
<h1 class="font-semibold text-white text-2xl">Your results</h1>
        <h2 class="text-slate-300">
          Your results are shown below based on the information you provided. To
          adjust the results, edit the form and click "calculate repayments"
          again.
        </h2>
        <div class="relative bg-[#d5dc47] rounded-md pt-1">
          <div class="relative bg-[#0e2431] rounded-md p-4 flex flex-col">
            <p class="text-slate-300">Your monthly repayments</p>
            <p class="text-[#d5dc47] font-bold text-[3.5rem]">${monthlyRepayment}</p>
            <div class="bg-[#324855] w-full rounded-full h-px"></div>
            <div class="flex flex-col gap-2 mt-4">
              <span class="text-slate-300"
                >Total you'll repay over the term</span
              >
              <span class="text-white font-bold text-2xl">${totalPayment}</span>
            </div>
          </div>
        </div>
      `;
    }
  });
</script>
