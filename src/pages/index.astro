---
import HomepageLayout from "../layouts/HomepageLayout.astro";
---

<HomepageLayout title="Welcome to Yuiko">
  <section id="hero" class="relative w-full">
    <div
      class="mx-auto flex min-h-svh w-full max-w-7xl flex-col items-center justify-center px-4"
    >
      <div
        class="mx-auto flex w-max flex-col items-center justify-center gap-2"
      >
        <h1
          class="text-stroke-black bg-gradient-to-r from-[#f38ba8] via-[#fab387] to-[#89b4fa] bg-clip-text font-permanent-marker text-6xl tracking-widest text-transparent"
        >
          Yuiko
        </h1>
        <h2 class="font-plus-jakarta text-lg">
          Make UI into pixel perfect website
        </h2>
        <div
          class="relative mt-4 flex items-center rounded-lg bg-[#11111b] p-2 font-jetbrain-mono text-xs sm:text-sm"
        >
          <span class="text-[#f38ba8]">const</span>
          <span class="ml-2 text-[#fab387]">yuiko</span>
          <span class="mx-2 text-[#f5e0dc]">=</span>
          <span class="text-[#fab387]">design</span>
          <span class="text-[#f5e0dc]">.</span>
          <span class="text-[#89b4fa]">transform</span>
          <span class="text-[#eba0ac]">(</span>
          <span class="text-[#a6e3a1]">"code"</span>
          <span class="text-[#eba0ac]">)</span>
        </div>
      </div>
    </div>
  </section>
</HomepageLayout>

